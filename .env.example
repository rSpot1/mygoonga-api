# Copiez ce fichier en ".env" et ajustez les valeurs.
# Pour un premier test rapide, vous n'avez besoin de RIEN changer : l'API démarre
# avec une base de données en mémoire et un stockage local des fichiers.

# --- Général ---
ENVIRONMENT=development
DEBUG_MODE=true
CORS_ORIGINS=*

# --- Base de données ---
# true  = base en mémoire, aucune configuration Firebase requise (idéal pour tester)
# false = Firestore réel (nécessite les variables FIREBASE_* ci-dessous)
USE_MOCK_DB=true

# --- Firebase (obligatoire uniquement si USE_MOCK_DB=false) ---
# Collez ici le contenu JSON du fichier de compte de service Firebase (Admin SDK),
# OU renseignez FIREBASE_CREDENTIALS_PATH avec le chemin vers ce fichier.
# FIREBASE_CREDENTIALS_JSON={"type": "service_account", ...}
# FIREBASE_CREDENTIALS_PATH=./secrets/firebase-service-account.json
# FIREBASE_PROJECT_ID=mygoonga-xxxxx
# FIREBASE_STORAGE_BUCKET=mygoonga-xxxxx.appspot.com

# --- Stockage des fichiers ---
# local    = écrit sur disque (./storage), utile en développement
# firebase = envoie vers Firebase Storage (nécessite la config Firebase ci-dessus)
STORAGE_MODE=local
LOCAL_STORAGE_DIR=./storage
SIGNED_URL_EXPIRY_SECONDS=900
SIGNED_URL_SECRET=change-me-in-production

# --- Hugging Face (facultatif ; sans token, la recherche d'image inversée est désactivée
# proprement et le reste de l'analyse continue de fonctionner) ---
# HUGGINGFACE_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HF_CLIP_MODEL=openai/clip-vit-base-patch32
HF_WHISPER_MODEL=openai/whisper-small
HF_SENTENCE_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Google Gemini (analyse visuelle IA de l'image, facultatif ; sans clé, cette
# étape est désactivée proprement et le reste de l'analyse continue de fonctionner) ---
# Clé gratuite : https://aistudio.google.com/apikey
# GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-2.5-flash
GEMINI_DAILY_IMAGE_LIMIT=50

# --- Analyse de cohérence média ---
ELA_QUALITY=90
ELA_ANOMALY_THRESHOLD=18.0
REVERSE_MATCH_SIMILARITY_THRESHOLD=0.92

# --- Scoring des événements locaux ---
FLAG_WEIGHT_VERIFIER=3
FLAG_WEIGHT_STANDARD=1
SCORE_THRESHOLD_RELIABLE=5
SCORE_THRESHOLD_DOUBTFUL=-5
NEARBY_DEFAULT_RADIUS_KM=15.0
